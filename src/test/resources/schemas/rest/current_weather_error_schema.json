{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WeatherAPI error response",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "integer"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}